# Server only. Scripted responses are visibly labeled when no AI key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
# Optional; validated against the account's /models endpoint before use.
GROQ_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional local neural character voices. Run `npm run voice:server` separately.
CHARACTER_VOICE_URL=http://127.0.0.1:7891
# Generate a private random value; the app and local voice service share it.
CHARACTER_VOICE_TOKEN=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Required on Vercel; local development uses process memory when absent.
# The Vercel Upstash integration supplies KV_REST_API_URL and KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Scripted AI is allowed only when explicitly enabled (local dev defaults true).
NEXT_PUBLIC_DEMO_MODE=true
# Groq cloud speech works on Vercel using GROQ_API_KEY. Set false for device voices.
GROQ_TTS_ENABLED=true
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
